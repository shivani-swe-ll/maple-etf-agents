# Copy this file to .env and fill in ONE option. Leave everything empty to run in rules-only mode.

# --- Option A: Anthropic (Claude) ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=your-key-here

# --- Option B: OpenAI or any OpenAI-compatible API (Groq, Together, ...) ---
# LLM_PROVIDER=openai
# LLM_MODEL=your-model-name
# OPENAI_API_KEY=your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Option C: free local model with Ollama (https://ollama.com) ---
# LLM_PROVIDER=openai
# LLM_MODEL=llama3.1
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1

# On Streamlit Community Cloud, do NOT upload .env. Instead open your app -> Settings -> Secrets
# and paste the same lines there, for example:
#   LLM_PROVIDER = "openai"
#   LLM_MODEL = "your-model-name"
#   OPENAI_API_KEY = "your-key"
#   OPENAI_BASE_URL = "https://your-provider/v1"
